# Local development; no API key needed for Ollama.
LLM_BACKEND=ollama
SUPERVISOR_VERSION=v2
OLLAMA_FAST_MODEL=qwen3:0.6b
OLLAMA_QUALITY_MODEL=qwen3:8b
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=capstone-all-total-ollama
# Optional: fill only in your private .env when using these services.
LANGSMITH_API_KEY=
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
